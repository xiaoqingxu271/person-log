# 复制为 .env 后按需修改：cp .env.example .env

# MySQL 连接串（本机 3306，或 docker compose 映射的 3307）
DATABASE_URL="mysql://personlog:personlog_pwd@127.0.0.1:3306/personlog"

# 会话签名密钥，生成方式：openssl rand -hex 32
AUTH_SECRET=""

# 站点对外地址（影响 RSS / sitemap / JSON-LD 中的链接；设为 https:// 域名后会话 Cookie 自动启用 Secure）
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# 初始管理员账号（seed 时使用；Docker 首次启动用户表为空时也会据此创建，上线前务必修改）
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="admin123456"

# SMTP 发信（可选）：留空则订阅免确认、评论通知与订阅群发自动跳过
# 配置后新订阅需点击邮件确认，确认后才纳入群发
SMTP_HOST=""
SMTP_PORT="587"
# 465 端口通常为隐式 TLS；不填时按端口自动判断
SMTP_SECURE=""
SMTP_USER=""
SMTP_PASS=""
# 发件人地址，留空时回退为 SMTP_USER
MAIL_FROM=""
