# 复制为 .env 后按需修改：cp .env.example .env

# ---------------- 本地开发（非 Docker） ----------------
# 本机 MySQL 连接串；使用 docker compose 时会被自动覆盖，无需修改
DATABASE_URL="mysql://personlog:personlog_pwd@127.0.0.1:3306/personlog"

# 会话签名密钥，生成方式：openssl rand -hex 32
AUTH_SECRET=""

# 站点对外地址（影响 RSS / sitemap / JSON-LD 中的链接；设为 https:// 域名后会话 Cookie 自动启用 Secure）
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ---------------- Docker 部署（docker compose 使用） ----------------
# 密码必填；建议只用字母数字，避免连接串转义问题
MYSQL_ROOT_PASSWORD=""
MYSQL_PASSWORD=""
MYSQL_USER="personlog"
MYSQL_DATABASE="personlog"
# MySQL 只绑定 127.0.0.1，本机调试可用该端口连接
MYSQL_HOST_PORT="3307"
# 应用只绑定 127.0.0.1，由 Nginx/Caddy 反代对外；局域网调试可改为 0.0.0.0
APP_BIND_IP="127.0.0.1"
APP_HOST_PORT="3000"

# 初始管理员账号（首次启动用户表为空时创建；Docker 部署必填，上线务必用强密码）
ADMIN_USERNAME="admin"
ADMIN_PASSWORD=""

# ---------------- SMTP 发信（可选） ----------------
# 留空则订阅免确认、评论通知与订阅群发自动跳过
# 配置后新订阅需点击邮件确认，确认后才纳入群发
SMTP_HOST=""
SMTP_PORT="587"
# 465 端口通常为隐式 TLS；不填时按端口自动判断
SMTP_SECURE=""
SMTP_USER=""
SMTP_PASS=""
# 发件人地址，留空时回退为 SMTP_USER
MAIL_FROM=""
